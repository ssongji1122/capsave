{
  "compilerOptions": {
    "baseUrl": "src", "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ESNext"], "jsx": "react-native", "resolveJsonModule": true,
    "esModuleInterop": true, "strict": true, "allowJs": true, "skipLibCheck": true,
    "noEmit": true, "noFallthroughCasesInSwitch": true, "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node", "react-native"],
    "paths": {"react": ["../node_modules/@types/react"], "react/*": ["../node_modules/@types/react/*"], "react-native": ["../node_modules/react-native"]}
  },
  "include": ["src", "pages", "require.context.ts", "index.ts", "granite.config.ts"]
}
